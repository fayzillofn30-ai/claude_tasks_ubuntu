# ROL XARITALASH — .env uslubi: o'zgartirish FAQAT shu yerda bo'ladi.
# Boshqa hech bir hujjatda haqiqiy ism yozilmaydi, faqat token nomlar ishlatiladi.
SUPERVISOR_USER=User
ORCESTOR_AGENT=Claude
EXECUTER_AGENT=agy

# SOZLAMALAR — bootstrap paytida so'raladi, shu yerda saqlanadi.
LANGUAGE=uz   # suhbat tili (masalan: uz, en, ru) — bootstrap'ning ENG BIRINCHI savoli, qayta so'ralmaydi
BATCH_SIZE=5
TRACKING_MODE=file
DB_ENGINE=sqlite   # TRACKING_MODE=db bo'lsa: sqlite | postgres | mysql
GIT_TRACK_ORCESTOR=false
PROJECT_STATUS_UPDATE=on_demand   # faqat ESKI loyihada: every_task | on_demand (bo'sh qoldirilsa yangi loyiha)

# POSTGRES (faqat TRACKING_MODE=db uchun) — Docker orqali, ASOSIY ILOVA BAZASIDAN MUSTAQIL/ALOHIDA.
# Bootstrap 3.4-savolida: yangi konteynermi yoki mavjudini qayta ishlatishmi — so'raladi.
# Qayta ishlatilsa ham, POSTGRES_DB har doim loyihaga XOS bo'lishi shart (pastdagidek, hech qachon yalang'och "orcestor" emas).
POSTGRES_CONTAINER_NAME=orcestor-db-loyiha-nomi
POSTGRES_PORT=55432
POSTGRES_VOLUME_PATH=./orcestor/db/pgdata
POSTGRES_DB=orcestor_loyiha-nomi
POSTGRES_USER=orcestor
POSTGRES_PASSWORD=orcestor

# MYSQL (faqat DB_ENGINE=mysql bo'lsa) — Docker orqali, ASOSIY ILOVA BAZASIDAN MUSTAQIL/ALOHIDA.
# Bootstrap 3.4-savolida: yangi konteynermi yoki mavjudini qayta ishlatishmi — so'raladi.
MYSQL_CONTAINER_NAME=orcestor-db-loyiha-nomi
MYSQL_PORT=33060
MYSQL_VOLUME_PATH=./orcestor/db/mysqldata
MYSQL_DATABASE=orcestor_loyiha-nomi
MYSQL_USER=orcestor
MYSQL_PASSWORD=orcestor
