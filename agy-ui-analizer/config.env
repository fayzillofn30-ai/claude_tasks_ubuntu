# agy-ui-analizer sozlamalari — limitlar va xavfsizlik chegaralari.
# Manba: GoogleAiStudio/GEMINI_API_TEST_REPORT.md (2026-08-04, real sinov)
# va ui_analiz_in_gemini_api_key/02-tadqiq-savollari.md#26 (2.6-bo'lim).
# Nusxa oling: cp config.env.example config.env (config.env — mahalliy,
# git'ga tushmasligi kerak bo'lsa .gitignore'ga qo'shing).

# --- Crawling chegaralari (review_pages.js) ---
# Bitta ishga tushirishda tekshiriladigan maksimal sahifalar soni.
# Katta/cheksiz saytlarda vaqt va keyingi Gemini kvotasini himoya qiladi.
MAX_PAGES=50

# Har bir sahifaga navigatsiya uchun maksimal kutish vaqti (millisekund).
CRAWL_NAV_TIMEOUT_MS=30000

# --- Gemini API chegaralari (analyze_pages.py) ---
# GEMINI_API_TEST_REPORT.md: 15 RPM (so'rov/daqiqa), 1500 RPD, 1M TPM.
# Bu yerda RPM'dan biroz pastroq (xavfsizlik zaxirasi bilan) qo'yilgan —
# ko'p sahifali crawl paytida limitga urilib qolmaslik uchun.
GEMINI_RPM_LIMIT=12

# Bitta kunlik ishga tushirishda ruxsat etilgan maksimal so'rovlar soni
# (RPD=1500 dan ancha past — bu ko'p marta ishga tushirish uchun zaxira
# qoldiradi, bitta katta crawl butun kunlik kvotani yeb qo'ymasligi uchun).
GEMINI_MAX_REQUESTS_PER_RUN=200

# 503 "high demand"/vaqtinchalik xatoliklar uchun qayta urinish siyosati
# (real sinovda 07-fayl#78'da 503 xatosi kuzatilgan, 15s kutib qayta
# urinishda muvaffaqiyatli o'tgan).
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_DELAY_SECONDS=15

# --- Agy fix-dispatch chegaralari (SKILL.md, 4-bosqich) ---
# Bitta `agy -p` chaqiruvi uchun maksimal kutish vaqti.
AGY_PRINT_TIMEOUT=5m

# Bitta ishga tushirishda nechta sahifaga FIX-DISPATCH ruxsat etiladi
# (0 = cheksiz emas — bu ataylab past, chunki fix-dispatch eng xavfli
# bosqich: fayllarni real o'zgartiradi. Ko'p sahifada bug topilsa,
# Supervisor_User'ga eskalatsiya qilinadi, hammasi ketma-ket avtomatik
# tuzatilmaydi — 3.5.4 tadqiqotidagi ochiq savolga bog'liq ehtiyot chorasi).
MAX_AUTO_FIX_PAGES=5
